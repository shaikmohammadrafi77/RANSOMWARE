    "agent": "node monitoring/agent.js",
    "clean": "node -e \"const fs=require('fs');['database/ransomware_monitor_js.db','ml_model/model','logs'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(_){}}); console.log('Cleaned')\""
